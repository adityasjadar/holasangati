# Copy this file to .env and fill in your own Supabase project values.
# Find these in Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to expose in frontend code (RLS policies protect the data).
# NEVER put the service_role key in this file or anywhere in frontend code.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
